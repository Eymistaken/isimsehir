<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon ön planı. 108x108dp tuval; tüm çizim 66dp güvenli bölgede
  (21..87) kalır, böylece hiçbir maske şeklinde kırpılmaz.
  Motif: çarkın üstündeki işaretçi + halka + göbek.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Çark halkası -->
    <path
        android:pathData="M32,60 A22,22 0 1 1 76,60 A22,22 0 1 1 32,60 Z"
        android:strokeColor="#E07B26"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Göbek -->
    <path
        android:pathData="M45,60 A9,9 0 1 1 63,60 A9,9 0 1 1 45,60 Z"
        android:fillColor="#F2EDE3" />

    <!-- İşaretçi -->
    <path
        android:pathData="M46,21 L62,21 L54,33 Z"
        android:fillColor="#F2EDE3" />
</vector>
