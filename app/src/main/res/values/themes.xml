<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IsimSehir" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <!-- Android 12+ SplashScreen API; core-splashscreen eski sürümlere de köprüler. -->
    <style name="Theme.IsimSehir.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.IsimSehir</item>
    </style>
</resources>
